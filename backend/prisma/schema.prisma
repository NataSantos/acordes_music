generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "sqlite"
}

model Sala {
  id         String   @id @default(uuid())
  nome       String
  capacidade Int

  descricao  String?

  agendamentos Agendamento[]
}

enum Role {
  ADMIN
  PROFESSOR
  ALUNO
}

model Usuario {
  id         String    @id @default(uuid())
  cpf        String       @unique
  nome       String
  telefone   String
  email      String    @unique
  senha      String
  role       Role
  foto       String?
  permissions String?

  professor  Professor?
  aluno      Aluno?
}

model Professor {
  id        String   @id @default(uuid())
  usuarioId String   @unique
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  createdAt DateTime @default(now())
  civil      String?
  endereco   String?
  profissao  String?

  agendamentos Agendamento[]
}

model Aluno {
  id        String   @id @default(uuid())
  usuarioId String   @unique
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  createdAt DateTime @default(now())
  matricula  String?
  redeSocial String?
  diaPagamento Int?

  agendamentos Agendamento[]
  pagamentos   Pagamento[]
}

model Pagamento {
  id        String   @id @default(uuid())
  alunoId   String
  mes       Int
  ano       Int
  pago      Boolean  @default(false)
  pagoEm    DateTime @default(now())
  valor     Float?
  tipoPagamento String?
  comprovanteUrl String?

  aluno Aluno @relation(fields: [alunoId], references: [id])

  @@unique([alunoId, mes, ano])
}

enum AgendamentoStatus {
  AGENDADO
  CONCLUIDO
}

model Agendamento {
  id         String            @id @default(uuid())
  professorId String
  alunoId    String
  salaId     String
  data       DateTime
  horario    String
  duracao    Int
  status     AgendamentoStatus @default(AGENDADO)
  valor      Float?
  observacao String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  professor Professor @relation(fields: [professorId], references: [id])
  aluno     Aluno     @relation(fields: [alunoId], references: [id])
  sala      Sala      @relation(fields: [salaId], references: [id])
}